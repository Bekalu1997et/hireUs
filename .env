# HireUs Environment Configuration Example
# Copy this file to .env and fill in your values

# ===================
# Application Settings
# ===================
APP_NAME=HireUs
APP_DESCRIPTION=AI-Powered Hiring Platform for Founders
DEBUG=True
ENVIRONMENT=development

# ===================
# Database Configuration
# ===================
# SQLite (for development)
DATABASE_URL=sqlite+aiosqlite:///./hireus.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hireus

# ===================
# JWT Authentication
# ===================
SECRET_KEY=K+4R3qEXjrG4dssvOqubRqfa/0Up65DMg6laSb3GsAg=
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ===================
# Google Gemini AI
# ===================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyAlIPhO7nteyDBYzhjiXFItuSxkN2DMi6o
GEMINI_MODEL=gemini-pro

# ===================
# Redis (Optional - for caching/sessions)
# ===================
REDIS_URL=redis://localhost:6379

# ===================
# Email Configuration (Optional)
# ===================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@hireus.com

# ===================
# Frontend Configuration
# ===================
# Next.js public environment variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=HireUs

