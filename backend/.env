# HireUs Environment Variables
# Copy this file to .env and fill in the values

# Application
APP_NAME="HireUs - AI-Powered Hiring Platform"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database
DATABASE_URL="postgresql+asyncpg://user:Siadle78Strong@localhost:5432/hire"
SYNC_DATABASE_URL="postgresql://user:Siadle78Strong@localhost:5432/hire"
DB_AUTO_CREATE_TABLES=false

# JWT
SECRET_KEY=72e96b1e36cb228fef0f550a855a0bbd75ea7ee6255172da97d3e7167b29ca95
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password
PASSWORD_MIN_LENGTH=8

# Email Configuration (Optional)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your-email@example.com"
# SMTP_PASSWORD="your-email-password"
# EMAILS_FROM_EMAIL="noreply@hireus.com"
# EMAILS_FROM_NAME="HireUs"

# First Superuser (for initial setup)
FIRST_SUPERUSER_EMAIL="admin@hireus.com"
FIRST_SUPERUSER_PASSWORD="change-this-password-in-production"

# AI Configuration (OpenAI)
# OPENAI_API_KEY="sk-your-openai-api-key"
# OPENAI_MODEL="gpt-4"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Local LLM (Ollama)
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_MODEL="tinyllama"

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Redis (Optional - for caching/sessions)
# REDIS_URL="redis://localhost:6379"
