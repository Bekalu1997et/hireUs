SYNC_DATABASE_URL="postgresql://user:password@localhost:5432/hireus"

# JWT
SECRET_KEY=K+4R3qEXjrG4dssvOqubRqfa/0Up65DMg6laSb3GsAg=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
